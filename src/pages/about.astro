---
import { getCollection, getEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';
import Page from '@/layouts/Page.astro';
import { removeUndefined } from '@/utils/remove-undefined';
import { sortByOrder } from '@/utils/sort';

const content = removeUndefined(await getEntry('page', 'about'));
const aboutmes = sortByOrder(await getCollection('aboutme'));
const aiautomations = sortByOrder(await getCollection('aiautomation'));
---

<Page
  active="about"
  title={content.data.title}
  description={content.data.description}
  navigationLinks={{ back: 'home', forward: 'skill' }}
>
  <div class="flex flex-col gap-14">
    <div class="flex flex-col gap-7">
      <div class="flex flex-col gap-2">
        <h2 class="text-lg font-semibold">About me</h2>
      </div>
      <div class="flex flex-col gap-2">
        <h2 class="text-lg font-semibold">AI Development & Automation</h2>
        <p class="text-gray-500 dark:text-gray-400">
          Building AI-powered products and MVPs — from agents and chatbots to
          RAG systems and LLM integrations.
        </p>
      </div>
      <div class="flex flex-col gap-8">
        {
          aiautomations.map((aiautomation) => (
            <div class="flex flex-col gap-x-5 gap-y-2 sm:flex-row">
              <span class="flex self-start rounded-md bg-gray-900 p-2 text-white dark:bg-gray-50 dark:text-black">
                <Icon icon={aiautomation.data.icon} />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="font-semibold">{aiautomation.data.title}</h3>
                <p class="text-gray-500 dark:text-gray-400">
                  {aiautomation.data.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex flex-col gap-7">
      <div class="flex flex-col gap-2">
        <h2 class="text-lg font-semibold">Areas of Specialization</h2>
        <p class="text-gray-500 dark:text-gray-400">
          A set of unorthodox yet complementary skills to create advantage.
        </p>
      </div>
      <div class="flex flex-col gap-8">
        {
          aboutmes.map((aboutme) => (
            <div class="flex flex-col gap-x-5 gap-y-2 sm:flex-row">
              <span class="flex self-start rounded-md bg-gray-900 p-2 text-white dark:bg-gray-50 dark:text-black">
                <Icon icon={aboutme.data.icon} />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="font-semibold">{aboutme.data.title}</h3>
                <p class="text-gray-500 dark:text-gray-400">
                  {aboutme.data.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Page>
